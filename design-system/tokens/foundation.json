{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$meta": {
    "name": "Ascend Learning Foundation Tokens",
    "version": "0.1.0",
    "source": "学习方案探索版 Figma 与已确认页面规范",
    "usage": "基础值只能被 semantic.json 或 components.json 引用，业务页面不直接硬编码。"
  },
  "fontFamily": {
    "sans": "HarmonyOS Sans SC, PingFang SC, Microsoft YaHei, sans-serif",
    "mono": "SF Mono, JetBrains Mono, Consolas, monospace"
  },
  "fontWeight": {
    "regular": 400,
    "medium": 500,
    "semibold": 600,
    "bold": 700
  },
  "fontSize": {
    "xs": 12,
    "sm": 14,
    "md": 16,
    "lg": 18,
    "xl": 20,
    "display": 40,
    "hero": 50
  },
  "lineHeight": {
    "tight": 1.25,
    "normal": 1.5,
    "relaxed": 1.6
  },
  "color": {
    "black": "#000000",
    "heading": "#101828",
    "secondary": "rgba(0, 0, 0, 0.6)",
    "muted": "#99A1AF",
    "white": "#FFFFFF",
    "surfaceSubtle": "#F5F6FA",
    "border": "#E5E7EB",
    "borderSubtle": "#F3F3F3",
    "brandRed": "#C7000B",
    "brandRedBright": "#DB0000",
    "linkBlue": "#2E53FA",
    "aiPurple": "#A78BFA",
    "success": "#17B26A",
    "warning": "#F5A623",
    "danger": "#D92D20"
  },
  "spacing": {
    "0": 0,
    "1": 4,
    "2": 8,
    "3": 12,
    "4": 16,
    "5": 20,
    "6": 24,
    "8": 32,
    "10": 40
  },
  "radius": {
    "sm": 4,
    "md": 8,
    "lg": 12,
    "xl": 16,
    "2xl": 24,
    "pill": 999
  },
  "shadow": {
    "sm": "0 1px 2px rgba(16, 24, 40, 0.08)",
    "md": "0 1px 3px rgba(16, 24, 40, 0.10)",
    "lg": "0 8px 24px rgba(16, 24, 40, 0.10)",
    "overlay": "0 16px 48px rgba(16, 24, 40, 0.18)"
  },
  "zIndex": {
    "content": 1,
    "localOverlay": 20,
    "sticky": 40,
    "modal": 80,
    "fullscreenFlow": 100
  }
}
